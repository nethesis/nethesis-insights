#
# Rendered to /etc/traefik/traefik.yaml at deploy time:
#   set -a; . /etc/insights/deploy.env; set +a
#   envsubst '$INSIGHTS_HOST $ACME_EMAIL' < traefik.yaml.tmpl > /etc/traefik/traefik.yaml
# INSIGHTS_HOST and ACME_EMAIL are both deploy-time inputs -- see
# dynamic.yaml.tmpl for the six Host() matchers INSIGHTS_HOST also drives.
# Both Traefik files are templates deliberately: templating one and leaving
# the other static is a trap, since the static one looks editable in place
# and either the edit is silently overwritten on the next render or it is
# not and the two quietly disagree.
entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint: {to: websecure, scheme: https, permanent: true}
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: le
    # Empty, deliberately: nothing sits in front of Traefik on this host, so
    # Traefik overwrites X-Forwarded-For with the connecting address. That
    # overwrite is what makes the pipelines' rightmost-value rule correct.
    forwardedHeaders:
      trustedIPs: []
  # Loopback-only and unpublished by insights.pod (see its PublishPort
  # comment: only 80 and 443 ever leave the pod). This is where Traefik's
  # OWN Prometheus exporter listens; it is never reachable directly, only
  # republished at the public /metrics/traefik path (dynamic.yaml's
  # metrics-traefik router, itself gated by metricsAuth) the same way the
  # four Go backends' own /metrics are. 8082 does not collide with any of
  # this deployment's other ports (9590, 9595-9596, 9605-9606, 9615-9616).
  metrics:
    address: "127.0.0.1:8082"

providers:
  file:
    # A directory, not a single filename, and that is load-bearing rather
    # than cosmetic: it is what lets the optional development monitoring
    # stack (deploy/dev/) drop a second file of routers in beside the
    # rendered dynamic.yaml without editing it. A production host never runs
    # deploy/dev/render-dev.sh, so that file does not exist there and neither
    # do its routers -- whereas putting them in dynamic.yaml.tmpl would leave
    # every deployment answering /grafana with a 502 towards a container it
    # is not running.
    #
    # Every file in here is merged into ONE namespace, so two files must
    # never define the same router, service or middleware name: that is a
    # last-one-wins race decided by filename order, not an error.
    # /etc/traefik itself stays outside this directory because it holds the
    # two htpasswd files, which are not Traefik configuration.
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  le:
    acme:
      email: ${ACME_EMAIL}
      storage: /acme/acme.json
      httpChallenge:
        entryPoint: web

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

log:
  level: INFO
accessLog: {}
