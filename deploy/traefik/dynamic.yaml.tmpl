# Rendered to /etc/traefik/dynamic.yaml at deploy time:
#   set -a; . /etc/insights/deploy.env; set +a
#   envsubst '$INSIGHTS_HOST $ACME_EMAIL' < dynamic.yaml.tmpl > /etc/traefik/dynamic.yaml
# Naming the variables in envsubst's argument matters: unquoted, it would
# also expand Traefik's own ${...} syntax. INSIGHTS_HOST drives the six
# Host() matchers below and the ACME certificate domain, and nothing else --
# if a second consumer appears, it reads the same variable rather than
# repeating the literal.
#
# A wrong or unset INSIGHTS_HOST fails recognisably: Traefik matches no
# router and every request 404s, which looks nothing like a misconfigured
# backend.
http:
  middlewares:
    # Sized for ~2700 nodes on this host with no firewall of any kind, once
    # authd becomes the single pre-auth entry point for all three pipelines.
    # Traefik's rateLimit buckets per source IP by default, and legitimate
    # per-node traffic is far under this: bundles post every 15 minutes
    # (~0.001 req/s), sizing reports post three times a day, and threat
    # events are batched into one POST per report rather than one per event.
    # average: 5req/s gives ~1000x headroom over that steady rate while still
    # capping a single misbehaving or compromised node (a retry loop, a
    # scripted flood) well short of being able to threaten authd's cache or a
    # backend's single SQLite writer. It is deliberately per-source rather
    # than a global cap: a global limit would let one loud client starve the
    # other 2699 nodes, which is worse than the DoS this exists to bound.
    #
    # burst is a different knob and must not be sized off the steady rate:
    # bundle windows are wall-clock aligned (the design spec's example window
    # is 08:00:00-08:15:00Z), so every node in a cluster behind one NAT egress
    # posts within moments of the same quarter hour, and the blocklist feed
    # poll is on the same 15-minute cadence. Traefik's token-bucket queues a
    # request only up to maxDelay = period/(2*average), 100ms here, so with
    # average: 5 the practical behaviour of a low burst is "burst requests
    # succeed, the rest are rejected outright" rather than smoothly queued --
    # one ordinary multi-node cluster sharing a public IP already exceeds a
    # burst of 10. 200 absorbs that synchronised arrival spike; it bounds
    # instantaneous depth only, so average: 5 still caps a retry loop or a
    # scripted flood exactly as intended.
    rate-limit:
      rateLimit:
        average: 5
        period: 1s
        burst: 200
    system-auth:
      forwardAuth:
        address: "http://127.0.0.1:9590/auth"
    operator-auth:
      basicAuth:
        usersFile: /etc/traefik/operators.htpasswd
        # false, deliberately: the app validates ADMIN_API_KEY itself and
        # needs the header. Setting this true breaks every UI write with a
        # 401 while the proxy still lets the request through.
        removeHeader: false
    strip-logs:
      stripPrefix:
        prefixes: ["/logs"]
    strip-blocklist:
      stripPrefix:
        prefixes: ["/blocklist"]
    strip-sizing:
      stripPrefix:
        prefixes: ["/sizing"]
    # A single `prometheus` user, checked here and only here -- never by the
    # Go backends, never against ADMIN_API_KEY or a node credential. The
    # password is generated by deploy/gen-metrics-auth.sh and lives in
    # /etc/insights/metrics.env; see docs/admin-guide.md's "Metrics" section.
    metrics-auth:
      basicAuth:
        usersFile: /etc/traefik/metrics.htpasswd
    # Each /metrics/<name> router below strips its own full path and adds
    # back the fixed backend path every binary registers its scrape
    # endpoint at (see internal/platform/metrics). Plain stripPrefix cannot
    # do this alone: it strips a leading prefix, and stripping a request
    # path's ENTIRE length leaves "" (which Traefik then forces to "/", not
    # "/metrics") -- there is no shorter prefix common to "/metrics/logs"
    # and the backend's "/metrics" for stripPrefix to remove instead. So
    # each strip-metrics-* consumes the whole public path, and this single
    # shared add-metrics-prefix puts the fixed "/metrics" back on afterwards
    # -- one middleware for all five routers, since every backend wants the
    # same path regardless of which one is being scraped.
    strip-metrics-logs:
      stripPrefix:
        prefixes: ["/metrics/logs"]
    strip-metrics-threat:
      stripPrefix:
        prefixes: ["/metrics/threat"]
    strip-metrics-sizing:
      stripPrefix:
        prefixes: ["/metrics/sizing"]
    strip-metrics-authd:
      stripPrefix:
        prefixes: ["/metrics/authd"]
    strip-metrics-traefik:
      stripPrefix:
        prefixes: ["/metrics/traefik"]
    add-metrics-prefix:
      addPrefix:
        prefix: "/metrics"

  routers:
    # Priority is explicit on all eleven: /blocklist/v1/ and /blocklist/
    # share a prefix, and getting the order backwards would put operator
    # BasicAuth on the ingest path, or the fleet's system credentials on the
    # operator UI. The five metrics-* routers below do not share a prefix
    # with anything else (their rule matches an exact `/metrics/<name>`
    # path, disjoint from /logs, /blocklist and /sizing), but every router
    # in this file still gets an explicit priority -- so a sixth router
    # added later, sharing a prefix with one of these, does not fall back to
    # Traefik's rule-specificity-length tiebreak by accident.
    #
    # entryPoints is pinned to websecure on all eleven for the same reason:
    # without it a router also attaches to web (plain :80), and its safety
    # over cleartext then rests on the web entrypoint's redirect router
    # happening to carry a higher default priority than this file's explicit
    # priorities -- an undefined ordering. Pinning removes the dependence.
    logs-api:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/logs/v1/`)"
      entryPoints: [websecure]
      priority: 200
      middlewares: [rate-limit, system-auth, strip-logs]
      service: logs-api
    logs-ui:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/logs`)"
      entryPoints: [websecure]
      priority: 100
      middlewares: [rate-limit, operator-auth, strip-logs]
      service: logs-ui
    blocklist-api:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/blocklist/v1/`)"
      entryPoints: [websecure]
      priority: 200
      middlewares: [rate-limit, system-auth, strip-blocklist]
      service: blocklist-api
    blocklist-ui:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/blocklist`)"
      entryPoints: [websecure]
      priority: 100
      middlewares: [rate-limit, operator-auth, strip-blocklist]
      service: blocklist-ui
    sizing-api:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/sizing/v1/`)"
      entryPoints: [websecure]
      priority: 200
      middlewares: [rate-limit, system-auth, strip-sizing]
      service: sizing-api
    sizing-ui:
      rule: "Host(`${INSIGHTS_HOST}`) && PathPrefix(`/sizing`)"
      entryPoints: [websecure]
      priority: 100
      middlewares: [rate-limit, operator-auth, strip-sizing]
      service: sizing-ui
    # Exact-path matches (Path, not PathPrefix): each /metrics/<name> is a
    # single scrape endpoint with no children, so there is nothing to
    # prefix-match and no ambiguity with the six routers above -- none of
    # them start with /metrics. Priority 300, above the API/UI tier, purely
    # so a later change to those never has to reason about this group too.
    metrics-logs:
      rule: "Host(`${INSIGHTS_HOST}`) && Path(`/metrics/logs`)"
      entryPoints: [websecure]
      priority: 300
      middlewares: [rate-limit, metrics-auth, strip-metrics-logs, add-metrics-prefix]
      service: metrics-logs
    metrics-threat:
      rule: "Host(`${INSIGHTS_HOST}`) && Path(`/metrics/threat`)"
      entryPoints: [websecure]
      priority: 300
      middlewares: [rate-limit, metrics-auth, strip-metrics-threat, add-metrics-prefix]
      service: metrics-threat
    metrics-sizing:
      rule: "Host(`${INSIGHTS_HOST}`) && Path(`/metrics/sizing`)"
      entryPoints: [websecure]
      priority: 300
      middlewares: [rate-limit, metrics-auth, strip-metrics-sizing, add-metrics-prefix]
      service: metrics-sizing
    metrics-authd:
      rule: "Host(`${INSIGHTS_HOST}`) && Path(`/metrics/authd`)"
      entryPoints: [websecure]
      priority: 300
      middlewares: [rate-limit, metrics-auth, strip-metrics-authd, add-metrics-prefix]
      service: metrics-authd
    metrics-traefik:
      rule: "Host(`${INSIGHTS_HOST}`) && Path(`/metrics/traefik`)"
      entryPoints: [websecure]
      priority: 300
      middlewares: [rate-limit, metrics-auth, strip-metrics-traefik, add-metrics-prefix]
      service: metrics-traefik

  services:
    logs-api:
      loadBalancer:
        # passHostHeader defaults to true and must stay true: the UI's
        # cross-site write check compares Origin to r.Host, and a rewritten
        # Host makes every write a 403.
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9595"}]
    logs-ui:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9596"}]
    blocklist-api:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9605"}]
    blocklist-ui:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9606"}]
    sizing-api:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9615"}]
    sizing-ui:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9616"}]
    metrics-logs:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9595"}]
    metrics-threat:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9605"}]
    metrics-sizing:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9615"}]
    metrics-authd:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:9590"}]
    # Traefik's own built-in exporter, on the loopback-only metrics
    # entryPoint declared in traefik.yaml.tmpl -- not one of the four Go
    # binaries. Traefik proxying to itself over loopback is the same shape
    # authd's forwardAuth call already is.
    metrics-traefik:
      loadBalancer:
        passHostHeader: true
        servers: [{url: "http://127.0.0.1:8082"}]
