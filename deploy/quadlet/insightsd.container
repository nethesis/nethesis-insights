[Unit]
Description=Log-anomaly pipeline
After=authd.service

[Container]
Image=ghcr.io/nethesis/nethesis-insights-insightsd:latest
ContainerName=insightsd
# No PublishPort: this container has no port of its own. It shares the pod's
# network namespace, so Traefik reaches it over real loopback and it sees
# RemoteAddr == 127.0.0.1 -- which is what makes the default
# TRUSTED_PROXY_CIDRS correct, and what the published-port arrangement could
# not deliver (a rootful PublishPort DNAT is masqueraded on the reply path, so
# the container would see the bridge gateway instead).
#
# One namespace means one port space: 9595/9596 are insightsd's alone and a
# collision is a startup failure, not a subtle misroute.
Pod=insights.pod
Volume=insights-logs.volume:/var/lib/insights
Environment=LISTEN_ADDR=127.0.0.1:9595
Environment=UI_LISTEN_ADDR=127.0.0.1:9596
Environment=UI_BASE_PATH=/logs
Environment=DB_PATH=/var/lib/insights/insights.db
Environment=TRUSTED_PROXY_CIDRS=127.0.0.0/8
# Debug is what separates the two rejected-request sentinels (untrusted
# proxy vs. no credential), so a pod networking mistake -- every valid
# credential 401ing -- reads differently from a client sending nothing.
# That is worth having while a deployment is new and not worth five log
# lines per request forever; raise it to debug for the length of an
# investigation, not as a resting state.
Environment=LOG_LEVEL=info
EnvironmentFile=/etc/insights/insightsd.env
# Each unit's OWN port. In a shared namespace a healthcheck pointed at the
# wrong port succeeds against a sibling container and reports its health as
# this one's -- a failure that looks like everything is fine.
HealthCmd=wget -qO- http://127.0.0.1:9595/healthz || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=5s

[Service]
Restart=always
# Without this, Restart=always hits systemd's default 5-in-10s start
# limit within half a second of any transient failure and the unit enters
# `failed` permanently -- needing systemctl reset-failed on a remote box
# nobody is watching.
RestartSec=5

[Install]
WantedBy=multi-user.target
