[Unit]
Description=Threat Shield pipeline
# After= alone orders the start but does not pull authd in: on a boot where
# authd.service fails, this unit still starts, and every request carrying a
# perfectly valid credential is then answered by a Traefik-generated 500 --
# observed on the live host, and indistinguishable from a backend fault.
# Wants=, not Requires=: propagating authd's failure by stopping this unit
# would turn a recoverable auth outage into a dead pipeline too, and this
# unit's own health check is what makes the difference visible instead.
After=authd.service
Wants=authd.service

[Container]
Image=ghcr.io/nethesis/nethesis-insights-threatd:latest
# The tag is mutable but podman does not re-resolve it: with no Pull= line it
# reuses whatever :latest already points at in local container storage, so a
# `systemctl restart` after a CI build silently keeps the old image while
# looking like it did something -- observed on the live host, three of four
# services running an image older than the one already cached beside it.
# `newer` compares the registry digest on every start and pulls only when it
# differs, falling back to the cached image when the registry is unreachable,
# so a boot with no network still starts. AutoUpdate=registry is not
# equivalent: it updates on podman-auto-update.timer, not on the restart an
# operator just ran.
Pull=newer
ContainerName=threatd
# No PublishPort: this container has no port of its own. It shares the pod's
# network namespace, so Traefik reaches it over real loopback and it sees
# RemoteAddr == 127.0.0.1 -- which is what makes the default
# TRUSTED_PROXY_CIDRS correct, and what the published-port arrangement could
# not deliver (a rootful PublishPort DNAT is masqueraded on the reply path, so
# the container would see the bridge gateway instead).
#
# One namespace means one port space: 9605/9606 are threatd's alone and a
# collision is a startup failure, not a subtle misroute.
Pod=insights.pod
Volume=insights-threat.volume:/var/lib/threat
Environment=LISTEN_ADDR=127.0.0.1:9605
Environment=UI_LISTEN_ADDR=127.0.0.1:9606
Environment=UI_BASE_PATH=/blocklist
Environment=DB_PATH=/var/lib/threat/threat.db
Environment=TRUSTED_PROXY_CIDRS=127.0.0.0/8
# Debug is what separates the two rejected-request sentinels (untrusted
# proxy vs. no credential), so a pod networking mistake -- every valid
# credential 401ing -- reads differently from a client sending nothing.
# That is worth having while a deployment is new and not worth five log
# lines per request forever; raise it to debug for the length of an
# investigation, not as a resting state.
Environment=LOG_LEVEL=info
EnvironmentFile=/etc/insights/threatd.env
# Each unit's OWN port. In a shared namespace a healthcheck pointed at the
# wrong port succeeds against a sibling container and reports its health as
# this one's -- a failure that looks like everything is fine.
HealthCmd=wget -qO- http://127.0.0.1:9605/healthz || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=5s

[Service]
Restart=always
# Without this, Restart=always hits systemd's default 5-in-10s start
# limit within half a second of any transient failure and the unit enters
# `failed` permanently -- needing systemctl reset-failed on a remote box
# nobody is watching.
RestartSec=5

[Install]
WantedBy=multi-user.target
