[Unit]
Description=Traefik reverse proxy
After=authd.service insightsd.service threatd.service sizingd.service

[Container]
Image=docker.io/library/traefik:v3.3
ContainerName=traefik
# In the pod, not on the host network: its connections to the four backends
# stay inside the shared namespace, which is what makes their RemoteAddr a
# real 127.0.0.1. Publishing is the pod's job (insights.pod), not this
# unit's -- this is the only unit that reaches the other four's ports, and it
# has none of its own to publish.
Pod=insights.pod
# :z relabels the bind-mounted host directory for SELinux (Enforcing on the
# target) -- without it Traefik gets EACCES on a config it can perfectly well
# read as root.
Volume=/etc/traefik:/etc/traefik:z
Volume=traefik-acme.volume:/acme
Exec=--configFile=/etc/traefik/traefik.yaml

[Service]
Restart=always
# Without this, Restart=always hits systemd's default 5-in-10s start
# limit within half a second of any transient failure and the unit enters
# `failed` permanently -- needing systemctl reset-failed on a remote box
# nobody is watching.
RestartSec=5

[Install]
WantedBy=multi-user.target
