[T1] count=2 module=modA priority=1 category=-
    tpl-a
[T2] count=5 module=modA priority=1 category=security
    tpl-z
[T3] count=1 module=modB priority=2 category=-
    tpl-m

SAMPLING
lines_seen=500 lines_kept=400 max_lines=1000
under_sampled (module dropped)
modA 1
modZ 3

